# ── backend (packages/backend/.env) ─────────────────────────────────────────
# Where the Phase 1 it-parts-system engine lives (its db/models/calculator/scanner dirs).
# Default resolves to ../../it-parts-system relative to the backend; override in Docker.
PHASE1_PATH=

# Persistent Phase 2 SQLite file (inventory lives here — back it up in prod).
OLEFLIP_DB_PATH=

# Single-user gate for mutating endpoints. Empty = open (dev only). Set in prod.
API_KEY=

# External services — server-side only, never sent to the browser.
# APIFY_API_TOKEN powers the GovDeals scanner (apify.com account token).
APIFY_API_TOKEN=
# eBay creds power the catalog's "Refresh prices" button. Use EITHER the
# RapidAPI pair (works today, your subscription's "Endpoints" tab shows both)
# OR the official Marketplace Insights pair (pending eBay approval).
EBAY_RAPIDAPI_KEY=
EBAY_RAPIDAPI_HOST=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

CORS_ORIGINS=http://localhost:3000

# ── agent system (LLM providers) — server-side only, never sent to the browser ──
# Set the keys for the providers you use. Anthropic powers 5 of 8 agents by
# default; DeepSeek powers 3 (cheapest); OpenAI/Grok are optional fallbacks.
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GROK_API_KEY=
# Per-agent model IDs (drift over time — override here without touching code).
# Defaults: e-scanner/research = claude-sonnet-5, e-customer/marketing = claude-haiku-4-5,
# auditor = claude-opus-4-8, e-pricer/e-listings/e-inventory = deepseek-chat.
MODEL_ESCANNER=
MODEL_EPRICER=
MODEL_ELISTINGS=
MODEL_EINVENTORY=
MODEL_ECUSTOMER=
MODEL_RESEARCH=
MODEL_MARKETING=
MODEL_AUDITOR=
# Optional per-agent provider override ("" = the agent's default provider).
# e.g. PROVIDER_ESCANNER=openai to re-point E-Scanner without a code change.
# Set to false to keep the background cron scheduler off (e.g. in CI).
AGENTS_SCHEDULER_ENABLED=true

# ── voice logging (Tier 2) ───────────────────────────────────────────────────
# Cheap/fast provider used to turn a spoken transcript into structured items.
VOICE_PROVIDER=deepseek
VOICE_MODEL=deepseek-chat

# ── notifications (Tier 3) — ALL optional, either / or / neither ─────────────
# A channel is inert until its value is set. Fill one, both, or leave empty.
# Discord: Server Settings → Integrations → Webhooks → New Webhook → Copy URL.
DISCORD_WEBHOOK_URL=
# Slack: api.slack.com/apps → your app → Incoming Webhooks → Add New Webhook.
SLACK_WEBHOOK_URL=
# Web Push (optional/advanced): a VAPID keypair (py_vapid can generate one).
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_EMAIL=admin@oleflip.local

# ── photo uploads (Tier 4) ───────────────────────────────────────────────────
# Storage dir + limits for inventory photos (defaults are sensible for dev).
UPLOAD_DIR=
MAX_PHOTO_SIZE_MB=10
MAX_PHOTOS_PER_ITEM=15

# ── web (packages/web/.env.local) ───────────────────────────────────────────
# Base URL the Next.js server proxy forwards /api/* to.
API_BASE=http://localhost:8000
# Same key as backend API_KEY; attached by the Next proxy, never shipped to client.
API_KEY=
